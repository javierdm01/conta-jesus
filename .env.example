DATABASE_URL=postgresql://instala:CAMBIA_ESTA_CLAVE@localhost:5432/instala
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
BETTER_AUTH_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Para acceso local: http://localhost:3000
# Para acceso desde otro dispositivo: http://TU_IP:3000 (ej. http://192.168.1.100:3000)
BETTER_AUTH_URL=http://localhost:3000
# Direcciones adicionales autorizadas, separadas por comas, con puerto exacto.
# Ejemplo para combinar ordenador y móvil: http://localhost:3000,http://192.168.1.153:3000
APP_TRUSTED_ORIGINS=
DOCUMENT_DIR=./data/documents
# En Windows, si Tesseract no figura en PATH:
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Para escuchar en todos los interfaces (permitir acceso desde otros dispositivos): 0.0.0.0
# Para escuchar solo en localhost: 127.0.0.1
PORT_BIND=0.0.0.0
# Solo durante la creación inicial o alta de un técnico desde consola:
ADMIN_EMAIL=propietario@empresa.local
ADMIN_PASSWORD=
ADMIN_NAME=Responsable
COMPANY_NAME=Mi empresa instaladora

# Agente de voz (opcional): sin clave solo funcionan las órdenes que entiende el parser.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4o-mini
